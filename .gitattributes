## Unity ##
*.cs diff=csharp text
*.cginc text
*.shader text
## Special rule for binary files (and large static text file)
Rewired_Core.XML filter=lfs diff=lfs merge=lfs -text
## Unity YAML ##
*.mat merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.physicsMaterial merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf<br>*TerrainData.asset filter=lfs diff=lfs merge=lfs -text<br>LightingData.asset filter=lfs diff=lfs merge=lfs -text<br>NavMesh-*.asset filter=lfs diff=lfs merge=lfs -text
*.meta merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
